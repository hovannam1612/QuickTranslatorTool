<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- keeps win-x64 in obj\project.assets.json even when an IDE restores without a runtime id -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.4</Version>
    <AssemblyName>QuickTranslator</AssemblyName>
    <RootNamespace>QuickTranslator</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <NoWarn>$(NoWarn);WFO5001;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- the same icon file is embedded so the tray/window icons are loaded from it at runtime -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
